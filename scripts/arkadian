#!/usr/bin/env bash

# Arkadian - Launch Claude Code with orchestrator system prompt
# This ensures ORCHESTRATOR.md instructions are in the SYSTEM prompt (highest priority)
# rather than as a user message (which Claude can ignore)
#
# Usage:
#   arkadian "your task"                           # Interactive mode
#   arkadian -d "your task"                        # Detached mode (auto-approves all gates)
#   arkadian --resume SESSION_ID                   # Resume from previous session

set -euo pipefail

ARKADIAN_DIR="${ARKADIAN_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
ORCHESTRATOR_FILE="${ARKADIAN_DIR}/ORCHESTRATOR.md"
DATA_DIR="${ARKADIAN_DATA_DIR:-${ARKADIAN_DIR}/log}"
SESSIONS_DIR="${ARKADIAN_DIR}/sessions"

# Check if orchestrator file exists
if [ ! -f "$ORCHESTRATOR_FILE" ]; then
    echo "Error: ORCHESTRATOR.md not found at $ORCHESTRATOR_FILE"
    exit 1
fi

# Read orchestrator content
ORCHESTRATOR_CONTENT=$(cat "$ORCHESTRATOR_FILE")

# Enable orchestrator mode for guardrail hooks
export ARKADIAN_ORCHESTRATOR_MODE=1

# Use native file search for agent/skill discovery instead of ripgrep.
# Claude Code defaults to ripgrep for scanning .md files in ~/.claude/agents/,
# but npm updates can reset the rg binary's execute permission, silently breaking
# agent discovery. Native search uses Node.js readdir — no external binary needed.
export CLAUDE_CODE_USE_NATIVE_FILE_SEARCH=1

DETACHED=false
EXPRESS=false
RESUME_SESSION=""
# ARKADIAN_RESUME_WORKFLOW_ID removed — no longer using --session-id for resume

# Show help
show_help() {
    echo "Arkadian - AI Orchestrator for Ark Protocol Ecosystem"
    echo ""
    echo "Usage:"
    echo "  arkadian [options] \"your task\""
    echo "  arkadian --resume <session_id> [-d]"
    echo "  arkadian status [session_id]"
    echo "  arkadian logs <session_id>"
    echo ""
    echo "Commands:"
    echo "  status            List active and recent sessions"
    echo "  status <id>       Show detailed status for a session"
    echo "  logs <id>         Tail session hook log"
    echo ""
    echo "Options:"
    echo "  -x, --express     Express mode: orchestrator implements directly, no sub-agents"
    echo "                    Best for quick fixes, unit tests, small changes (1-3 files)"
    echo "  -d, --detached    Run autonomously in background (auto-approve all gates)"
    echo "  --resume <id>     Resume a previous session from its last completed phase"
    echo "                    <id> can be UUID or friendly name (e.g., 2026-02-12-fix-bug)"
    echo "  --help, -h        Show this help message"
    echo ""
    echo "Examples:"
    echo "  # Start new session (interactive)"
    echo "  arkadian \"Fix the VTXO expiry bug in fulmine\""
    echo ""
    echo "  # Express mode (small tasks, no sub-agents, ~5-8x cheaper)"
    echo "  arkadian -x \"add unit test for computeNextExpiry in arkd\""
    echo ""
    echo "  # Express + detached (fast autonomous execution)"
    echo "  arkadian -x -d \"fix typo in service.go\""
    echo ""
    echo "  # Start new session (detached)"
    echo "  arkadian -d \"Add GetRoundMetrics RPC to arkd\""
    echo ""
    echo "  # Resume by UUID (interactive)"
    echo "  arkadian --resume 3191f042-a27d-4a6e-b6a8-f2fe0f41bc9a"
    echo ""
    echo "  # Resume by friendly name (interactive)"
    echo "  arkadian --resume 2026-02-12-add-event-stream-fulmine"
    echo ""
    echo "  # Resume in detached mode (auto-approve remaining phases)"
    echo "  arkadian --resume 2026-02-12-add-event-stream-fulmine -d"
    echo ""
    echo "  # Check session status"
    echo "  arkadian status"
    echo "  arkadian status 2026-02-12-add-event-stream-fulmine"
    echo ""
    echo "  # View session logs"
    echo "  arkadian logs abc123-def456"
}

# ── Helpers for status/logs ──────────────────────────────────────────

# Human-readable relative time from ISO timestamp
relative_time() {
    local ts="$1"
    local now
    now=$(date +%s)
    local then
    # Handle both ISO and epoch formats
    if [[ "$ts" =~ ^[0-9]+$ ]]; then
        then="$ts"
    else
        then=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${ts%%.*}" +%s 2>/dev/null || date -d "$ts" +%s 2>/dev/null || echo "$now")
    fi
    local diff=$(( now - then ))
    if (( diff < 60 )); then
        echo "${diff}s ago"
    elif (( diff < 3600 )); then
        echo "$(( diff / 60 ))m ago"
    elif (( diff < 86400 )); then
        echo "$(( diff / 3600 ))h ago"
    else
        echo "$(( diff / 86400 ))d ago"
    fi
}

# ── status subcommand ────────────────────────────────────────────────

cmd_status() {
    local detail_id="${1:-}"
    mkdir -p "$DATA_DIR"

    if [ -n "$detail_id" ]; then
        cmd_status_detail "$detail_id"
        return
    fi

    # ── Active sessions ──
    local found_active=false
    for state_file in "$DATA_DIR"/*_state.json; do
        [ -f "$state_file" ] || continue

        local sid
        sid=$(jq -r '.session_id' "$state_file" 2>/dev/null) || continue
        local pid
        pid=$(jq -r '.pid' "$state_file" 2>/dev/null)
        local started
        started=$(jq -r '.started_at' "$state_file" 2>/dev/null)
        local phase
        phase=$(jq -r '.workflow.current_phase // "initializing"' "$state_file" 2>/dev/null)
        local agent
        agent=$(jq -r '.active_agent.agent_type // "-"' "$state_file" 2>/dev/null)

        local status_label="RUNNING"
        if ! kill -0 "$pid" 2>/dev/null; then
            status_label="STALE (PID $pid dead)"
        fi

        if [ "$found_active" = false ]; then
            echo "ACTIVE SESSIONS:"
            found_active=true
        fi

        local rel
        rel=$(relative_time "$started")
        printf "  %-20s %-10s %-28s %s\n" "${sid:0:20}" "$status_label" "$phase ($agent)" "$rel"
    done

    if [ "$found_active" = false ]; then
        echo "No active sessions."
    fi

    # ── Recent completed sessions ──
    local manifest="${ARKADIAN_DIR}/sessions/.index/manifest.json"
    if [ -f "$manifest" ]; then
        echo ""
        echo "RECENT (last 5):"
        # jq: pick first 5 entries, format as table
        jq -r '.[0:5] | .[] | "  \(.session_id)\t\(.project)\t\(.outcome)\t\(.created_at)"' "$manifest" 2>/dev/null | \
        while IFS=$'\t' read -r sid project outcome created; do
            local rel
            rel=$(relative_time "$created")
            printf "  %-52s %-12s %-10s %s\n" "$sid" "$project" "$outcome" "$rel"
        done
    fi
}

cmd_status_detail() {
    local id="$1"

    # Try active state file first
    local state_file="$DATA_DIR/${id}_state.json"
    if [ -f "$state_file" ]; then
        local sid pid started phase wf_status
        sid=$(jq -r '.session_id' "$state_file")
        pid=$(jq -r '.pid' "$state_file")
        started=$(jq -r '.started_at' "$state_file")
        phase=$(jq -r '.workflow.current_phase // "initializing"' "$state_file")
        wf_status=$(jq -r '.workflow.status' "$state_file")

        local status_label="RUNNING (PID $pid)"
        if ! kill -0 "$pid" 2>/dev/null; then
            status_label="STALE (PID $pid dead)"
        fi

        local rel
        rel=$(relative_time "$started")

        echo "Session: $sid"
        echo "Status:  $status_label"
        echo "Started: ${started%%.*} ($rel)"

        # Session dir from active pointer
        local active_file="$DATA_DIR/${id}_active.txt"
        if [ -f "$active_file" ]; then
            echo "Dir:     $(cat "$active_file" | tr -d '\n')"
        fi

        echo ""
        echo "Workflow: $wf_status"
        echo "Current:  $phase"
        echo ""

        # Show phases
        local phases
        phases=$(jq -r '.phases | to_entries[] | "\(.key)\t\(.value.agent // "-")\t\(.value.status)"' "$state_file" 2>/dev/null)
        if [ -n "$phases" ]; then
            echo "Phases:"
            echo "$phases" | while IFS=$'\t' read -r pname pagent pstatus; do
                printf "  %-16s %-20s %s\n" "$pname" "$pagent" "$pstatus"
            done
        fi

        # Show artifacts
        local session_dir=""
        if [ -f "$active_file" ]; then
            session_dir=$(cat "$active_file" | tr -d '\n')
        fi
        if [ -n "$session_dir" ] && [ -d "$session_dir/artifacts" ]; then
            echo ""
            local artifacts
            artifacts=$(find "$session_dir/artifacts" -type f \( -name '*.yaml' -o -name '*.md' -o -name '*.json' \) 2>/dev/null)
            if [ -n "$artifacts" ]; then
                local count
                count=$(echo "$artifacts" | wc -l | tr -d ' ')
                echo "Artifacts: $count files"
                echo "$artifacts" | while read -r f; do
                    echo "  ${f#"$session_dir"/}"
                done
            fi
        fi
        return
    fi

    # Try ended session — check log file
    local log_file="$DATA_DIR/${id}_log.txt"
    if [ -f "$log_file" ]; then
        echo "Session: $id (ended)"
        echo "Log:     $log_file"
        echo ""

        # Extract start time from log
        local start_line
        start_line=$(head -1 "$log_file")
        echo "Started: $start_line"
        echo ""

        # Look for phase transitions in log
        echo "Phase events (from log):"
        grep -E '\[session-start\]|\[orchestrator-guardrail\].*phase|workflow|agent' "$log_file" 2>/dev/null | tail -20
        return
    fi

    # Try manifest for renamed session
    local manifest="${ARKADIAN_DIR}/sessions/.index/manifest.json"
    if [ -f "$manifest" ]; then
        local entry
        entry=$(jq -r --arg id "$id" '.[] | select(.session_id == $id or (.session_id | contains($id)))' "$manifest" 2>/dev/null)
        if [ -n "$entry" ]; then
            echo "$entry" | jq -r '"Session: \(.session_id)\nProject: \(.project)\nOutcome: \(.outcome)\nDir:     \(.session_dir)\nCreated: \(.created_at)\n\nArtifacts:\n\(.artifacts | map("  " + .) | join("\n"))"'
            return
        fi
    fi

    # Try searching by UUID in workflow.yaml files (for renamed sessions)
    local session_dir=""
    for workflow in $(find "${ARKADIAN_DIR}/sessions" -maxdepth 3 -name "workflow.yaml" 2>/dev/null); do
        local workflow_id
        workflow_id=$(grep -m1 "^workflow_id:" "$workflow" 2>/dev/null | awk '{print $2}')
        if [ -n "$workflow_id" ] && [[ "$workflow_id" == "$id"* ]]; then
            session_dir=$(dirname "$workflow")
            echo "Session found by UUID: $(basename "$session_dir")"
            echo "Dir:     $session_dir"
            echo ""

            # Show workflow status
            echo "Workflow:"
            grep -E "^(status|template):" "$workflow" | sed 's/^/  /'
            echo ""

            # Show phase completion
            echo "Phases:"
            for phase_dir in "$session_dir/artifacts"/*; do
                if [ -d "$phase_dir" ]; then
                    local phase_name
                    phase_name=$(basename "$phase_dir")
                    local result_file="${phase_dir}/_result.json"

                    if [ -f "$result_file" ]; then
                        local status agent
                        status=$(jq -r '.status // "unknown"' "$result_file" 2>/dev/null)
                        agent=$(jq -r '.agent // "unknown"' "$result_file" 2>/dev/null)
                        printf "  %-16s %-20s %s\n" "$phase_name" "$agent" "$status"
                    else
                        printf "  %-16s %-20s %s\n" "$phase_name" "-" "pending/failed"
                    fi
                fi
            done

            # Check planning artifacts separately
            if [ -d "$session_dir/specs" ]; then
                for spec_dir in "$session_dir/specs"/*/*/; do
                    if [ -f "${spec_dir}_result.json" ]; then
                        local feature_name
                        feature_name=$(basename "$(dirname "$spec_dir")")
                        local status agent
                        status=$(jq -r '.status // "unknown"' "${spec_dir}_result.json" 2>/dev/null)
                        agent=$(jq -r '.agent // "unknown"' "${spec_dir}_result.json" 2>/dev/null)
                        printf "  %-16s %-20s %s\n" "plan:$feature_name" "$agent" "$status"
                    fi
                done
            fi

            return
        fi
    done

    echo "Session '$id' not found."
    echo "Try: arkadian status   (to list sessions)"
}

# ── logs subcommand ──────────────────────────────────────────────────

cmd_logs() {
    local id="${1:-}"
    if [ -z "$id" ]; then
        echo "Usage: arkadian logs <session_id>"
        exit 1
    fi

    local log_file="$DATA_DIR/${id}_log.txt"
    if [ ! -f "$log_file" ]; then
        echo "No log file found for session '$id'"
        echo "  Expected: $log_file"
        exit 1
    fi

    # If session is active (state file exists), follow the log
    local state_file="$DATA_DIR/${id}_state.json"
    if [ -f "$state_file" ]; then
        local pid
        pid=$(jq -r '.pid' "$state_file" 2>/dev/null)
        if kill -0 "$pid" 2>/dev/null; then
            echo "=== Following active session log (Ctrl+C to stop) ==="
            tail -f "$log_file"
            return
        fi
    fi

    # Ended session — show last 50 lines
    echo "=== Session log (last 50 lines) ==="
    tail -50 "$log_file"
}

# Dispatch subcommands before flag parsing
case "${1:-}" in
    status)
        shift
        cmd_status "$@"
        exit 0
        ;;
    logs)
        shift
        cmd_logs "$@"
        exit 0
        ;;
    --resume)
        # Handle --resume as both subcommand and flag
        if [ -n "${2:-}" ]; then
            RESUME_SESSION="$2"
            shift 2
            # Check if next arg is -d/--detached
            if [ "${1:-}" = "-d" ] || [ "${1:-}" = "--detached" ]; then
                DETACHED=true
                shift
            fi
        else
            echo "Error: --resume requires a session ID"
            echo "Usage: arkadian --resume <session_id> [-d]"
            exit 1
        fi
        ;;
esac

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        -x|--express)
            EXPRESS=true
            shift
            ;;
        -d|--detached)
            DETACHED=true
            shift
            ;;
        --resume)
            if [ -n "${2:-}" ]; then
                RESUME_SESSION="$2"
                shift 2
                # Check if next arg is -d/--detached
                if [ "${1:-}" = "-d" ] || [ "${1:-}" = "--detached" ]; then
                    DETACHED=true
                    shift
                fi
            else
                echo "Error: --resume requires a session ID"
                echo "Usage: arkadian --resume <session_id> [-d]"
                exit 1
            fi
            ;;
        *)
            # Remaining args go to claude
            break
            ;;
    esac
done

# Detached mode prompt override
DETACHED_PROMPT='## Detached Mode (AUTO-APPROVE)

You are running in DETACHED mode. There is no human operator to approve gates.

**Override to Approval Gates:**
- All 3 approval gates (Plan, Spec, Subsequent Call) are PRE-APPROVED.
- Do NOT output "AWAITING PLAN APPROVAL" or "AWAITING SPEC APPROVAL" prompts.
- Do NOT stop and wait for user input between phases.
- After generating a plan → immediately create workflow.yaml → proceed to first spec.
- After generating each spec → immediately invoke the agent.
- After each agent completes → immediately proceed to next phase.

**What stays the same:**
- Follow the FULL orchestrator workflow (all 10 steps).
- Create ALL artifacts: workflow.yaml, execution specs, session state.
- Run ALL phases: explore → plan → implement → test.
- Log every decision, every spec, every artifact — exactly as in interactive mode.
- Write all specs to sessions/{session_id}/specs/ as normal.
- Respect hook enforcement (pre-agent, post-agent validators).
- Retry on agent failure (up to 3x) as normal.

**Resolving agent decisions:**
- If an agent (e.g., ark-guru) presents multiple options with a recommendation, accept the recommendation.
- If an agent flags an "architectural decision needed", treat the agent'\''s preferred option as decided.
- Do NOT surface agent questions to the user — there is no user. Resolve them using the agent'\''s stated preference.
- Record all auto-resolved decisions in the orchestrator log for post-hoc review.

**In summary:** Execute the entire pipeline end-to-end without pausing. Produce identical artifacts to interactive mode.'

# Express mode prompt override
EXPRESS_PROMPT='## Express Mode (DIRECT EXECUTION)

You are running in EXPRESS mode. You do ALL work DIRECTLY — no sub-agents, no delegation.
The user explicitly chose -x to avoid the overhead of spawning agents. Respect that choice.

**What changes:**
- After Steps 1-4 (load registry, classify intent, select project(s), load project INDEX):
  - Write workflow.yaml with execution_mode: "direct" (REQUIRED — guardrail unlocks Bash/repo access only after this)
  - Then do the work yourself — directly. No Task/Agent tool.
  - For code tasks: Read code → Edit/Write → Run tests → Commit
  - For investigations/Q&A: Read code across projects → Analyze → Write findings to session artifacts
  - For any other task: Use your tools (Read, Grep, Glob, Bash, Edit, Write) to complete it
- All approval gates are PRE-APPROVED (no stopping, no "AWAITING APPROVAL" prompts)
- Do NOT invoke any sub-agents (no Task/Agent tool calls)
- Still create workflow.yaml and write output to session artifacts

**What stays the same:**
- Follow Steps 1-4: Load INDEX.md, classify intent, select projects, load project INDEX
- Create workflow.yaml BEFORE doing any repo work (guardrail enforces this)
- Use skills if needed (Skill tool is allowed)
- Multi-project access is allowed — load multiple project INDEXes, read from multiple repos

**NEVER refuse express mode.** The user chose -x explicitly. Do the work directly regardless of task size or type.
If the task is complex, do your best — a direct answer is always better than refusing.'

# ── Resume Mode Validation and Setup ─────────────────────────────────

RESUME_PROMPT=""
if [ -n "$RESUME_SESSION" ]; then
    # Strip phase suffix (e.g., -S2, -S3) from session ID if present
    # Users may pass "session-id-S2" meaning "resume from phase S2"
    RESUME_FROM_PHASE=""
    if [[ "$RESUME_SESSION" =~ ^(.+)-S([0-9]+)$ ]]; then
        RESUME_FROM_PHASE="S${BASH_REMATCH[2]}"
        RESUME_SESSION="${BASH_REMATCH[1]}"
        echo "Phase hint detected: will suggest resuming from ${RESUME_FROM_PHASE}"
        echo "  Session ID: $RESUME_SESSION"
        echo ""
    fi
    # Validate session exists
    SESSION_DIR=""

    # Try to find session directory by matching prefix or exact ID
    # Sessions can be in sessions/{session_id} or sessions/{project}/{session_id}
    if [ -d "${SESSIONS_DIR}/${RESUME_SESSION}" ] && [ -f "${SESSIONS_DIR}/${RESUME_SESSION}/workflow.yaml" ]; then
        # Found at direct path AND has workflow.yaml
        SESSION_DIR="${SESSIONS_DIR}/${RESUME_SESSION}"
    else
        # Try matching in nested project directories (sessions/arkd/, sessions/fulmine/, etc.)
        # Only accept directories that have workflow.yaml
        MATCHING_DIRS=""
        for dir in $(find "$SESSIONS_DIR" -maxdepth 2 -type d -name "${RESUME_SESSION}*" 2>/dev/null); do
            if [ -f "$dir/workflow.yaml" ]; then
                MATCHING_DIRS="${MATCHING_DIRS}${dir}"$'\n'
            fi
        done
        DIR_COUNT=$(echo "$MATCHING_DIRS" | grep -cv '^$' 2>/dev/null) || DIR_COUNT=0

        if [ "$DIR_COUNT" -eq 1 ]; then
            SESSION_DIR=$(echo "$MATCHING_DIRS" | grep -v '^$') || SESSION_DIR=""
        elif [ "$DIR_COUNT" -gt 1 ]; then
            echo "Error: Multiple sessions match '${RESUME_SESSION}':"
            echo "$MATCHING_DIRS" | sed 's/^/  /'
            echo ""
            echo "Please provide a more specific session ID."
            exit 1
        fi
    fi

    # If still not found, try searching by original UUID in workflow.yaml files
    # (sessions get renamed after completion, but workflow_id preserves original UUID)
    if [ -z "$SESSION_DIR" ]; then
        echo "Searching for session by UUID in workflow files..."
        for workflow in $(find "$SESSIONS_DIR" -maxdepth 3 -name "workflow.yaml" 2>/dev/null); do
            # Try workflow_id first (new format)
            WORKFLOW_ID=$(grep -m1 "^workflow_id:" "$workflow" 2>/dev/null | awk '{print $2}' | tr -d '"') || WORKFLOW_ID=""

            # Fallback to session_id if workflow_id not found (old format)
            if [ -z "$WORKFLOW_ID" ]; then
                WORKFLOW_ID=$(grep -m1 "^session_id:" "$workflow" 2>/dev/null | awk '{print $2}' | tr -d '"') || WORKFLOW_ID=""
            fi

            if [ -n "$WORKFLOW_ID" ] && [[ "$WORKFLOW_ID" == "$RESUME_SESSION"* ]]; then
                SESSION_DIR=$(dirname "$workflow")
                echo "Found session by UUID: $(basename "$SESSION_DIR")"
                break
            fi
        done
    fi

    if [ -z "$SESSION_DIR" ] || [ ! -d "$SESSION_DIR" ]; then
        echo "Error: Session '${RESUME_SESSION}' not found in ${SESSIONS_DIR}"
        echo ""
        echo "Searched for:"
        echo "  - Directory name matching: ${RESUME_SESSION}"
        echo "  - UUID in workflow.yaml files"
        echo ""
        echo "Available sessions (use 'arkadian status' for full list):"
        find "$SESSIONS_DIR" -maxdepth 2 -type d ! -name ".*" ! -name "sessions" 2>/dev/null | tail -10 | sed 's|.*/||' | sed 's/^/  /' || true
        exit 1
    fi

    # Extract actual session ID from directory name
    RESUME_SESSION=$(basename "$SESSION_DIR")

    echo "Resuming session: $RESUME_SESSION"
    echo "  Source: $SESSION_DIR"
    echo ""

    # Check if workflow.yaml exists
    if [ ! -f "${SESSION_DIR}/workflow.yaml" ]; then
        echo "Error: No workflow.yaml found in session directory"
        echo "  This session may not be resumable (orchestration not started)"
        exit 1
    fi

    # Export old session dir — the session-start hook will:
    # 1. Create a fresh session folder (Claude generates new session ID)
    # 2. Copy all files from this old session into the new folder
    # 3. Update workflow_id and paths in copied files
    # 4. Delete this old session folder
    export ARKADIAN_RESUME_SESSION_DIR="$SESSION_DIR"
    export ARKADIAN_RESUME_SESSION="$RESUME_SESSION"

    # Build resume prompt with optional phase hint
    PHASE_HINT=""
    if [ -n "$RESUME_FROM_PHASE" ]; then
        PHASE_HINT="
**Phase Hint:** User requested resume from ${RESUME_FROM_PHASE}. Verify this phase is
actually the next pending phase. If earlier phases are incomplete, resume from the
earliest incomplete phase instead."
    fi

    RESUME_PROMPT="## Resume Mode

You are resuming a workflow from a previous session. This is a FRESH Claude session.
The SessionStart hook has copied all files from the previous session into YOUR session folder.
Your session folder path is in the Session Context injected by the hook above.

**Previous session:** ${RESUME_SESSION}
${PHASE_HINT}

**Instructions — execute IMMEDIATELY on first user message:**

1. Read workflow.yaml from your session folder
2. Check _result.json files to find completed vs pending phases:
   - artifacts/{phase}/_result.json for execution phases (explore, implement, review)
   - specs/{project}/{feature}/_result.json for planning phases
3. For the FIRST pending phase:
   - If specs/S{N}.yaml exists → read it and present for approval
   - If it does NOT exist → create it (load INDEX.md, select projects, build spec)
4. After approval, invoke the agent
5. Continue workflow for remaining phases

**Critical:**
- Do NOT re-run completed phases (check _result.json status)
- If spec does not exist, CREATE it following standard orchestration workflow
- Include artifacts_in from ALL completed prior phases
- Follow all approval gates
"

    echo "Session state analysis:"
    echo ""

    # Show phase status - check both artifacts/ and specs/
    # Execution phases (explore, implement) → artifacts/{phase}/
    # Planning phase → specs/{project}/{feature-id}/

    # Check execution phases in artifacts/
    for phase_dir in "${SESSION_DIR}/artifacts"/*; do
        if [ -d "$phase_dir" ]; then
            phase_name=$(basename "$phase_dir")
            result_file="${phase_dir}/_result.json"

            if [ -f "$result_file" ]; then
                status=$(jq -r '.status // "unknown"' "$result_file" 2>/dev/null) || status="unknown"
                agent=$(jq -r '.agent // "unknown"' "$result_file" 2>/dev/null) || agent="unknown"

                if [ "$status" = "complete" ] || [ "$status" = "success" ]; then
                    echo "  ✅ ${phase_name}: COMPLETE (${agent})"
                elif [ "$status" = "partial" ]; then
                    echo "  ⚠️  ${phase_name}: PARTIAL (${agent})"
                elif [ "$status" = "failed" ]; then
                    echo "  ❌ ${phase_name}: FAILED (${agent})"
                else
                    echo "  ❓ ${phase_name}: ${status} (${agent})"
                fi
            else
                echo "  ⏸️  ${phase_name}: IN PROGRESS or FAILED (no _result.json)"
            fi
        fi
    done

    # Check planning phase in specs/
    if [ -d "${SESSION_DIR}/specs" ]; then
        plan_result=$(find "${SESSION_DIR}/specs" -name "_result.json" -type f 2>/dev/null | head -1) || plan_result=""
        if [ -n "$plan_result" ]; then
            agent=$(jq -r '.agent // "unknown"' "$plan_result" 2>/dev/null) || agent="unknown"
            project=$(dirname "$plan_result" | xargs basename) || project="unknown"
            echo "  ✅ plan: COMPLETE (${agent} - ${project})"
        fi
    fi

    # Determine next phase from workflow.yaml (not from existing spec files)
    # This prevents false "all complete" when specs haven't been created yet
    COMPLETED_STEP_IDS=""
    for result_file in $(find "${SESSION_DIR}/artifacts" "${SESSION_DIR}/specs" -name "_result.json" -type f 2>/dev/null); do
        step=$(jq -r '.step_id // ""' "$result_file" 2>/dev/null) || step=""
        status=$(jq -r '.status // "unknown"' "$result_file" 2>/dev/null) || status="unknown"
        if [ -n "$step" ] && { [ "$status" = "complete" ] || [ "$status" = "success" ]; }; then
            COMPLETED_STEP_IDS="${COMPLETED_STEP_IDS}${step} "
        fi
    done

    # Parse all phase IDs from workflow.yaml (in order)
    ALL_PHASES=$(grep -- '- id: "S' "${SESSION_DIR}/workflow.yaml" | sed 's/.*- id: "\(S[0-9]*\)".*/\1/') || ALL_PHASES=""
    if [ -z "$ALL_PHASES" ]; then
        TOTAL_PHASES=0
    else
        TOTAL_PHASES=$(echo "$ALL_PHASES" | wc -l | tr -d ' ')
    fi
    COMPLETED_COUNT=0
    NEXT_PHASE=""

    for phase in $ALL_PHASES; do
        if echo "$COMPLETED_STEP_IDS" | grep -qw "$phase" 2>/dev/null; then
            COMPLETED_COUNT=$((COMPLETED_COUNT + 1))
        elif [ -z "$NEXT_PHASE" ]; then
            NEXT_PHASE="$phase"
        fi
    done

    echo ""
    echo "  Progress: ${COMPLETED_COUNT}/${TOTAL_PHASES} phases complete"

    if [ -n "$NEXT_PHASE" ]; then
        NEXT_SPEC="${SESSION_DIR}/specs/${NEXT_PHASE}.yaml"
        if [ -f "$NEXT_SPEC" ]; then
            echo "  Next phase: ${NEXT_PHASE} (spec exists: $(basename "$NEXT_SPEC"))"
        else
            echo "  Next phase: ${NEXT_PHASE} (orchestrator will create spec)"
            NEXT_SPEC=""  # Orchestrator needs to create it
        fi
    else
        echo ""
        echo "✅ All phases complete - workflow finished"
        echo ""
        echo "Session: $RESUME_SESSION"
        echo "Location: $SESSION_DIR"
        echo ""
        echo "To review results:"
        echo "  ls -la \"$SESSION_DIR/artifacts\""
        echo ""
        exit 0
    fi

    echo ""
    echo "Starting orchestrator in resume mode..."
    echo ""
fi

# Build claude command args
ARKADIAN_SETTINGS="$HOME/.claude/settings-arkadian.json"
CLAUDE_ARGS=(
  --settings "$ARKADIAN_SETTINGS"
  --append-system-prompt "$ORCHESTRATOR_CONTENT"
)

# Express mode: inject express context into system prompt and set env var
if [ "$EXPRESS" = true ]; then
    CLAUDE_ARGS+=(--append-system-prompt "$EXPRESS_PROMPT")
    export ARKADIAN_WORKFLOW_MODE=express
fi

# Resume mode: inject resume context into system prompt
# No --session-id: Claude generates fresh session, hook copies old files into it
if [ -n "$RESUME_PROMPT" ]; then
    CLAUDE_ARGS+=(--append-system-prompt "$RESUME_PROMPT")
fi

if [ "$DETACHED" = true ]; then
    CLAUDE_ARGS+=(-p)
    CLAUDE_ARGS+=(--append-system-prompt "$DETACHED_PROMPT")
    CLAUDE_ARGS+=(--dangerously-skip-permissions)

    # Create a timestamp marker to find the new session
    MARKER=$(mktemp)

    # Start claude in background, fully detached
    mkdir -p "$DATA_DIR"
    LOG_FILE="${DATA_DIR}/arkadian_$$.log"

    # In resume mode, pass minimal trigger; otherwise pass through user args
    if [ -n "$RESUME_PROMPT" ]; then
        # Resume mode: send minimal trigger to activate orchestrator's resume workflow
        nohup claude "${CLAUDE_ARGS[@]}" "resume" > "$LOG_FILE" 2>&1 &
    else
        nohup claude "${CLAUDE_ARGS[@]}" "$@" > "$LOG_FILE" 2>&1 &
    fi
    PID=$!
    disown "$PID" 2>/dev/null

    # Wait for session-start hook to create _active.txt (max 30s)
    SESSION_DIR=""
    for _ in $(seq 1 30); do
        NEW_ACTIVE=$(find "$DATA_DIR" -maxdepth 1 -name "*_active.txt" -newer "$MARKER" 2>/dev/null | head -1) || NEW_ACTIVE=""
        if [ -n "$NEW_ACTIVE" ]; then
            SESSION_DIR=$(tr -d '\n' < "$NEW_ACTIVE")
            break
        fi
        sleep 1
    done
    rm -f "$MARKER"

    if [ -n "$SESSION_DIR" ]; then
        # Symlink log into session folder (can't move — fd still open)
        ln -sf "$LOG_FILE" "${SESSION_DIR}/output.log" 2>/dev/null || true
        echo "Arkadian detached (PID ${PID})"
        echo "  ${SESSION_DIR}"
    else
        echo "Arkadian detached (PID ${PID})"
        echo "  ${LOG_FILE}"
    fi

    exit 0
fi

# Interactive mode
if [ -n "$RESUME_PROMPT" ]; then
    # Resume mode: pass "resume" as initial prompt — starts REPL and auto-triggers orchestrator
    exec claude "${CLAUDE_ARGS[@]}" "resume"
else
    # Normal mode: pass through any user arguments
    exec claude "${CLAUDE_ARGS[@]}" "$@"
fi
