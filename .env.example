# Arkadian Environment Variables
# Copy this file to .env and fill in your actual paths
# Usage: cp .env.example .env && vim .env

# Core Arkadian directory (this repository)
ARKADIAN_DIR=/path/to/arkadian

# Project repositories (12 total)
ARKD_REPO=/path/to/ark
GO_SDK_REPO=/path/to/ark-sdk
WALLET_REPO=/path/to/wallet
ARK_FAUCET_REPO=/path/to/ark-faucet
ARK_SIMULATOR_REPO=/path/to/ark-simulator
ARK_TELEMETRY_REPO=/path/to/ark-telemetry
ARK_INFRA_REPO=/path/to/ark-infra
KMS_UNLOCKER_REPO=/path/to/kms-unlocker
FULMINE_REPO=/path/to/fulmine
BOLTZ_BACKEND_REPO=/path/to/boltz-backend
ARK_DOCS_REPO=/path/to/ark-docs
ARKADE_ESCROW_REPO=/path/to/arkade-escrow

ARKD_GITHUB
GO_SDK_GITHUB
WALLET_GITHUB
ARK_FAUCET_GITHUB
ARK_SIMULATOR_GITHUB
ARK_TELEMETRY_GITHUB
ARK_INFRA_GITHUB
KMS_UNLOCKER_GITHUB
FULMINE_GITHUB
BOLTZ_BACKEND_GITHUB
ARK_DOCS_GITHUB