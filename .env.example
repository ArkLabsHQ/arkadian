# Arkadian Environment Variables
# Copy this file to .env and fill in your actual paths
# Usage: cp .env.example .env && vim .env

# Core Arkadian directory (this repository)
ARKADIAN_DIR=/path/to/arkadian

# Runtime data directory (OS-specific, auto-detected during install)
# macOS: ~/Library/Application Support/Arkadian
# Linux: ~/.arkadian
ARKADIAN_DATA_DIR=/path/to/data-dir

# ===========================================
# Project repositories (20 total)
# ===========================================

# --- Core (required) ---
ARKD_REPO=/path/to/ark
GO_SDK_REPO=/path/to/go-sdk
WALLET_REPO=/path/to/wallet

# --- SDKs ---
TS_SDK_REPO=/path/to/ts-sdk
RUST_SDK_REPO=/path/to/rust-sdk
DOTNET_SDK_REPO=/path/to/dotnet-sdk

# --- Services ---
FULMINE_REPO=/path/to/fulmine
ARK_FAUCET_REPO=/path/to/ark-faucet
BANCOD_REPO=/path/to/bancod

# --- Swap Infrastructure ---
BOLTZ_BACKEND_REPO=/path/to/boltz-backend
BOLTZ_SWAP_REPO=/path/to/boltz-swap
BANCO_REPO=/path/to/banco

# --- Smart Contracts ---
COMPILER_REPO=/path/to/compiler
INTROSPECTOR_REPO=/path/to/introspector

# --- Applications ---
ARKADE_ESCROW_REPO=/path/to/arkade-escrow
ARKADE_EXPLORER_REPO=/path/to/arkade-explorer
ARKADE_ASSETS_REPO=/path/to/arkade-assets

# --- Testing & Simulation ---
ARK_SIMULATOR_REPO=/path/to/ark-simulator

# --- Infrastructure & Ops ---
ARK_TELEMETRY_REPO=/path/to/ark-telemetry
ARK_INFRA_REPO=/path/to/ark-infra
KMS_UNLOCKER_REPO=/path/to/kms-unlocker

# --- Documentation ---
ARK_DOCS_REPO=/path/to/ark-docs

# ===========================================
# GitHub repository URLs (for progress tracking)
# Format: org/repo
# ===========================================
ARKD_GITHUB=arkade-os/arkd
GO_SDK_GITHUB=arkade-os/go-sdk
WALLET_GITHUB=arkade-os/wallet
TS_SDK_GITHUB=arkade-os/ts-sdk
RUST_SDK_GITHUB=arkade-os/rust-sdk
DOTNET_SDK_GITHUB=arkade-os/dotnet-sdk
FULMINE_GITHUB=ArkLabsHQ/fulmine
ARK_FAUCET_GITHUB=ArkLabsHQ/ark-faucet
BOLTZ_BACKEND_GITHUB=BoltzExchange/boltz-backend
BOLTZ_SWAP_GITHUB=arkade-os/boltz-swap
COMPILER_GITHUB=ArkLabsHQ/compiler
INTROSPECTOR_GITHUB=ArkLabsHQ/introspector
ARKADE_ESCROW_GITHUB=ArkLabsHQ/arkade-escrow
ARKADE_EXPLORER_GITHUB=ArkLabsHQ/arkade-explorer
ARKADE_ASSETS_GITHUB=ArkLabsHQ/arkade-assets
ARK_SIMULATOR_GITHUB=ArkLabsHQ/ark-simulator
ARK_TELEMETRY_GITHUB=ArkLabsHQ/ark-telemetry
ARK_INFRA_GITHUB=ArkLabsHQ/ark-infra
KMS_UNLOCKER_GITHUB=ArkLabsHQ/kms-unlocker
ARK_DOCS_GITHUB=arkade-os/docs
BANCOD_GITHUB=arkade-os/bancod
BANCO_GITHUB=arkade-os/banco
