{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Usage Log Entry",
  "description": "Schema for context budget usage tracking logs",
  "type": "object",
  "required": ["timestamp", "execution_id", "final_usage"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when log entry was created"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Links to execution-history.json record"
    },
    "final_usage": {
      "type": "object",
      "required": ["total_tokens", "tier1", "tier2", "tier3", "tier4"],
      "properties": {
        "total_tokens": {"type": "integer", "minimum": 0, "maximum": 200000},
        "tier1": {"type": "integer", "minimum": 0},
        "tier2": {"type": "integer", "minimum": 0},
        "tier3": {"type": "integer", "minimum": 0},
        "tier4": {"type": "integer", "minimum": 0}
      }
    },
    "overflow_events": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of overflow events during this execution"
    },
    "strategies_applied": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["prioritize_recent_files", "prefer_usage_docs", "summarize_large_files", "ask_user_narrow_scope"]
      }
    },
    "files_loaded_count": {
      "type": "integer",
      "minimum": 0
    },
    "peak_usage_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
