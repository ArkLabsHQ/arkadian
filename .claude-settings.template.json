{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ARKADIAN_DIR": "ARKADIAN_DIR_PLACEHOLDER"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "LS(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "NotebookRead(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "ExitPlanMode(*)",
      "Task(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(fork bomb)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(mkfs.ext4 /dev/sda)",
      "Bash(> /dev/sda)"
    ]
  },
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [],
    "Notification": [],
    "SessionStart": [
      {
        "type": "command",
        "command": "bun ${ARKADIAN_DIR}/hooks/session-start-hook.ts"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bun ${ARKADIAN_DIR}/hooks/update-tab-titles.ts"
      },
      {
        "type": "command",
        "command": "bun ${ARKADIAN_DIR}/hooks/load-arkadian-context.ts"
      }
    ],
    "Stop": [],
    "SubagentStop": [],
    "PreCompact": [
      {
        "type": "command",
        "command": "bun ${ARKADIAN_DIR}/hooks/context-compression-hook.ts"
      }
    ]
  }
}
