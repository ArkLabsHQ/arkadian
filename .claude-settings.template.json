{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ARKADIAN_DIR": "ARKADIAN_DIR_PLACEHOLDER"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "LS(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "NotebookRead(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "ExitPlanMode(*)",
      "Task(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(fork bomb)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(mkfs.ext4 /dev/sda)",
      "Bash(> /dev/sda)"
    ],
    "additionalDirectories": [
      "ARKD_REPO_PLACEHOLDER",
      "GO_SDK_REPO_PLACEHOLDER",
      "WALLET_REPO_PLACEHOLDER",
      "ARK_FAUCET_REPO_PLACEHOLDER",
      "ARK_SIMULATOR_REPO_PLACEHOLDER",
      "ARK_TELEMETRY_REPO_PLACEHOLDER",
      "ARK_INFRA_REPO_PLACEHOLDER",
      "KMS_UNLOCKER_REPO_PLACEHOLDER",
      "FULMINE_REPO_PLACEHOLDER",
      "BOLTZ_BACKEND_REPO_PLACEHOLDER",
      "ARK_DOCS_REPO_PLACEHOLDER",
      "ARKADE_ESCROW_REPO_PLACEHOLDER"
    ]
  },
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [],
    "Notification": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/load-arkadian-context.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/session-start-hook.ts"
          }
        ]
      }
    ],
    "Stop": [],
    "SubagentStop": [],
    "SessionEnd": []
  }
}
