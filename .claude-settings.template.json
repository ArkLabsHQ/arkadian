{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ARKADIAN_DIR": "ARKADIAN_DIR_PLACEHOLDER",
    "ARKADIAN_DATA_DIR": "ARKADIAN_DATA_DIR_PLACEHOLDER"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(*)",
      "Write(*)",
      "Write(/ARKADIAN_DIR_PLACEHOLDER/sessions/**)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "LS(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "NotebookRead(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "ExitPlanMode(*)",
      "Task(*)",
      "Agent(*)",
      "Skill(*)",
      "AskUserQuestion(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(fork bomb)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(mkfs.ext4 /dev/sda)",
      "Bash(> /dev/sda)"
    ],
    "additionalDirectories": [
      "ARKD_REPO_PLACEHOLDER",
      "GO_SDK_REPO_PLACEHOLDER",
      "WALLET_REPO_PLACEHOLDER",
      "TS_SDK_REPO_PLACEHOLDER",
      "RUST_SDK_REPO_PLACEHOLDER",
      "DOTNET_SDK_REPO_PLACEHOLDER",
      "FULMINE_REPO_PLACEHOLDER",
      "ARK_FAUCET_REPO_PLACEHOLDER",
      "BOLTZ_BACKEND_REPO_PLACEHOLDER",
      "BOLTZ_SWAP_REPO_PLACEHOLDER",
      "COMPILER_REPO_PLACEHOLDER",
      "INTROSPECTOR_REPO_PLACEHOLDER",
      "ARKADE_ESCROW_REPO_PLACEHOLDER",
      "ARKADE_EXPLORER_REPO_PLACEHOLDER",
      "ARKADE_ASSETS_REPO_PLACEHOLDER",
      "ARK_SIMULATOR_REPO_PLACEHOLDER",
      "ARK_TELEMETRY_REPO_PLACEHOLDER",
      "ARK_INFRA_REPO_PLACEHOLDER",
      "KMS_UNLOCKER_REPO_PLACEHOLDER",
      "ARK_DOCS_REPO_PLACEHOLDER"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/pre-agent-validator.ts"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/pre-agent-validator.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/orchestrator-guardrail.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/subagent-guardrail.ts"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Notification": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/user-submit-reminder.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/session-start-hook.ts"
          }
        ]
      }
    ],
    "Stop": [],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/post-agent-validator.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${ARKADIAN_DIR}/hooks/session-stop-hook.ts"
          }
        ]
      }
    ]
  }
}
